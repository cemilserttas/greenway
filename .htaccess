Header always set Content-Security-Policy 
"default-src 'unsafe-inline' 'unsafe-eval'; \
  base-uri 'self'; \
  connect-src 'self'; \
  frame-src 'self'; \
  frame-ancestors 'self'; \
  font-src 'self'; \
  form-action 'self'; \
  img-src 'self' data:; \
  script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com/vue@3/dist/vue.global.js https://cdn.jsdelivr.net; \
  style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; \
  worker-src 'self' blob:;"
